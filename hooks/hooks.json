{
  "description": "Refuse COMPLETED without a receipt. Add to your Claude Code settings hooks or load via the plugin.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/refuse_unreceipted.py\""
          }
        ]
      }
    ]
  }
}
